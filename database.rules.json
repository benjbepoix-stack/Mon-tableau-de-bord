{
  "rules": {
    ".read": false,
    ".write": false,
    "app": {
      ".read": true,
      ".write": true,
      "dashboard": {
        "$collection": {
          ".validate": "$collection === 'tasks' || $collection === 'appointments' || $collection === 'events'",
          "$i": {
            ".validate": "newData.hasChildren(['id', 'title']) && newData.child('title').isString() && newData.child('title').val().length <= 100"
          }
        }
      },
      "notes": { ".validate": "newData.isString() && newData.val().length <= 20000" },
      "theme": { ".validate": "newData.val() === 'light' || newData.val() === 'dark'" },
      "families": {
        "$i": { ".validate": "newData.hasChildren(['id', 'name']) && newData.child('name').isString() && newData.child('name').val().length <= 60" }
      },
      "plans": {
        "$day": { ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)" }
      },
      "objectives": { ".validate": true },
      "races": {
        "$i": { ".validate": "newData.hasChildren(['id', 'name', 'date']) && newData.child('name').isString() && newData.child('name').val().length <= 100" }
      },
      "bodyMetrics": {
        "$series": { ".validate": "$series === 'weight' || $series === 'ftp' || $series === 'measurements'" }
      },
      "garage_alerts": {
        "$vehicleId": {
          ".validate": "newData.hasChildren(['vehicleName', 'updatedAt']) && newData.child('vehicleName').isString() && newData.child('vehicleName').val().length <= 100"
        }
      },
      "maison_alerts": {
        ".validate": "newData.hasChildren(['name', 'updatedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 100"
      },
      "$other": { ".validate": false }
    }
  }
}
